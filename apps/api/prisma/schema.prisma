generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  BARBER
  CLIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

model Barbershop {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  phone           String?
  address         String?
  neighborhood    String?
  city            String?
  state           String?
  zipCode         String?
  street          String?
  number          String?
  email           String?
  cnpj            String?   @unique
  corporateName   String?
  cnpjStatus      String?
  cnpjStatusDate  DateTime?
  cnpjConsultedAt DateTime?
  cnpjSource      String?
  cnae            String?
  logoUrl         String?
  coverUrl        String?
  description     String?
  openingHours    Json?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ownerId      String?   @unique
  owner        User?     @relation("BarbershopOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  users           User[]
  services        Service[]
  appointments    Appointment[]
  professionals   Professional[]
  holidays        BarbershopHoliday[]
  subscription    Subscription?
  reviews         Review[]
  favorites       Favorite[]
  publications    Publication[]
  contactMessages ContactMessage[]
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  password     String
  name         String
  phone        String?
  avatarUrl    String?
  role         Role        @default(CLIENT)
  barbershopId String?
  barbershop   Barbershop? @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  ownedBarbershop     Barbershop?   @relation("BarbershopOwner")
  professionalProfile Professional?
  clientAppointments  Appointment[] @relation("ClientAppointments")
  barberAppointments  Appointment[] @relation("BarberAppointments")
  reviews             Review[]      @relation("ClientReviews")
  favorites           Favorite[]    @relation("ClientFavorites")
  publications        Publication[] @relation("AuthorPublications")
}

model Professional {
  id           String      @id @default(uuid())
  name         String
  email        String?
  phone        String?
  avatarUrl    String?
  commission   Float       @default(0.0)
  workingHours Json?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  barbershopId String
  barbershop   Barbershop  @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  userId       String?     @unique
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  appointments Appointment[]
}

model Service {
  id           String     @id @default(uuid())
  name         String
  description  String?
  price        Float
  durationMin  Int        @default(30)
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  appointments Appointment[]
}

model Appointment {
  id           String            @id @default(uuid())
  dateTime     DateTime
  status       AppointmentStatus @default(PENDING)
  notes        String?
  totalPrice   Float?

  barbershopId String
  barbershop   Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  serviceId    String
  service      Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  clientId     String
  client       User              @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)

  barberId     String
  barber       User              @relation("BarberAppointments", fields: [barberId], references: [id], onDelete: Cascade)

  professionalId String?
  professional   Professional?   @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  review       Review?

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Holiday {
  id         String   @id @default(uuid())
  name       String
  date       DateTime
  isNational Boolean  @default(true)
  state      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  barbershopHolidays BarbershopHoliday[]
}

model BarbershopHoliday {
  id           String    @id @default(uuid())
  date         DateTime
  description  String?
  isClosed     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  holidayId    String?
  holiday      Holiday?   @relation(fields: [holidayId], references: [id], onDelete: SetNull)
}

model Plan {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  interval    String   @default("MONTHLY")
  features    Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id           String             @id @default(uuid())
  status       SubscriptionStatus @default(ACTIVE)
  startDate    DateTime           @default(now())
  endDate      DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  barbershopId String             @unique
  barbershop   Barbershop         @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  planId       String
  plan         Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
}

model Review {
  id           String   @id @default(uuid())
  rating       Int
  comment      String?
  photos       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientId     String
  client       User     @relation("ClientReviews", fields: [clientId], references: [id], onDelete: Cascade)

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  appointmentId String? @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
}

model Favorite {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())

  clientId     String
  client       User     @relation("ClientFavorites", fields: [clientId], references: [id], onDelete: Cascade)

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([clientId, barbershopId])
}

model Publication {
  id           String   @id @default(uuid())
  title        String?
  content      String?
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  authorId     String?
  author       User?      @relation("AuthorPublications", fields: [authorId], references: [id], onDelete: SetNull)
}

model ContactMessage {
  id           String      @id @default(uuid())
  senderName   String
  senderEmail  String
  subject      String
  message      String
  status       String      @default("PENDING")
  reply        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  barbershopId String?
  barbershop   Barbershop? @relation(fields: [barbershopId], references: [id], onDelete: SetNull)
}

model BroadcastCommunication {
  id             String    @id @default(uuid())
  title          String
  content        String
  targetAudience String    @default("ALL")
  scheduledAt    DateTime?
  sentAt         DateTime?
  status         String    @default("SENT")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model PlatformAnnouncement {
  id             String    @id @default(uuid())
  title          String
  content        String
  type           String    @default("BANNER")
  couponCode     String?
  discountPercent Float?
  targetAudience String    @default("ALL")
  startDate      DateTime?
  endDate        DateTime?
  active         Boolean   @default(true)
  viewsCount     Int       @default(0)
  usageCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model FeatureToggle {
  key       String   @id
  name      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeatureToggleHistory {
  id         String   @id @default(uuid())
  featureKey String
  action     String
  adminId    String?
  adminEmail String?
  reason     String?
  createdAt  DateTime @default(now())
}

model PlatformSettings {
  id              String   @id @default("default")
  platformName    String   @default("Central de Barbearias")
  supportEmail    String   @default("suporte@barberecosystem.com.br")
  phone           String?
  maintenanceMode Boolean  @default(false)
  footerTexts     Json?
  pricingSettings Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
