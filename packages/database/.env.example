# Neon PostgreSQL Database Connection Strings
# Replace values with your Neon Database connection pooler and direct URLs

# Connection pooler URL (Recommended for Serverless / Next.js / Express)
DATABASE_URL="postgresql://neondb_owner:your_password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct URL for migrations / Prisma shadow database
DIRECT_URL="postgresql://neondb_owner:your_password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"
